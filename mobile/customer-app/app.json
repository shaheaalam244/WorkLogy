{
  "expo": {
    "name": "WorkLogy",
    "slug": "worklogy-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/worklogy-app-icon-v2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.worklogy.customer"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/worklogy-adaptive-icon-v2.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "in.worklogy.customer",
      "versionCode": 1
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/native-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/worklogy-app-icon-v2.png",
          "color": "#2563EB",
          "defaultChannel": "customer_updates"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "defa7868-3bd7-44ce-9aa8-84b7eb4188be"
      }
    },
    "owner": "shaheaalam244"
  }
}
