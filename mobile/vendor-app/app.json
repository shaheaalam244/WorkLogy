{
  "expo": {
    "name": "WorkLogy",
    "slug": "worklogy-vendor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/worklogy-app-icon-v2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.worklogy.vendor"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/worklogy-adaptive-icon-v2.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "in.worklogy.vendor",
      "versionCode": 1
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/native-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/worklogy-app-icon-v2.png",
          "color": "#2563EB",
          "defaultChannel": "general"
        }
      ],
      "expo-secure-store",
      "expo-font"
    ]
  }
}
